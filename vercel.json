{
    "version": 2,
    "builds": [
        {
            "src": "limefolio/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.9"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/staticfiles/$1"
        },
        {
            "src": "/(.*)",
            "dest": "limefolio/wsgi.py"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "limefolio.settings"
    },
    "buildCommand": "bash build.sh"
}
