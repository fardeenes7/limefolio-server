# ============================================
# LIMEFOLIO SERVER ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# For production deployment, set these in Vercel project settings

# ============================================
# DJANGO CORE SETTINGS
# ============================================

# Secret key for Django (REQUIRED)
# Generate a new one for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug mode (REQUIRED)
# Set to False in production!
DEBUG=True

# Allowed hosts (REQUIRED)
# Comma-separated list of allowed hostnames
# Production example: .vercel.app,yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# ============================================
# DATABASE SETTINGS
# ============================================

# Database URL (REQUIRED for production)
# Development (SQLite): Leave empty or comment out to use SQLite
# Production (PostgreSQL): postgresql://user:password@host:port/database
# Examples:
#   Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb
#   Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#   Railway: postgresql://postgres:password@containers-us-west-xxx.railway.app:7633/railway
DATABASE_URL=postgresql://user:password@localhost:5432/limefolio

# ============================================
# CORS SETTINGS
# ============================================

# CORS allowed origins (REQUIRED)
# Comma-separated list of allowed frontend URLs
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# AWS S3 / CLOUDFLARE R2 SETTINGS
# ============================================
# Required for media file storage in production

# Access credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bucket configuration
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Endpoint URL
# AWS S3: https://s3.amazonaws.com or https://s3.region.amazonaws.com
# Cloudflare R2: https://[account-id].r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://your-endpoint-url

# Custom domain for media files (optional but recommended)
# AWS S3: your-bucket-name.s3.amazonaws.com
# Cloudflare R2: your-custom-domain.com or your-bucket.r2.dev
AWS_S3_CUSTOM_DOMAIN=your-custom-domain

# Region (for AWS S3, use 'auto' for Cloudflare R2)
AWS_S3_REGION_NAME=auto

# Query string authentication (set to False for public media files)
AWS_QUERYSTRING_AUTH=False

# ============================================
# OAUTH / SOCIAL LOGIN SETTINGS (Optional)
# ============================================

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# EMAIL SETTINGS (Optional)
# ============================================

# Email backend
# Development: django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (required if using SMTP backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# FRONTEND SETTINGS
# ============================================

# Frontend URL (for redirects, emails, etc.)
FRONTEND_URL=http://localhost:3000

# ============================================
# DJANGO SITES FRAMEWORK
# ============================================

# Site ID (default: 1)
# Required by django-allauth and social-auth
SITE_ID=1

